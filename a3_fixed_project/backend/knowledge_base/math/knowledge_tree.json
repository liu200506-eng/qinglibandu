{
    "roots": [
        {
            "id": "math",
            "name": "数学",
            "description": "数学知识体系",
            "children": [
                {
                    "id": "algebra",
                    "name": "代数",
                    "description": "代数学基础知识",
                    "children": [
                        {
                            "id": "linear_equations",
                            "name": "一元一次方程",
                            "description": "只含有一个未知数，且未知数的次数是1的方程",
                            "difficulty": 0.3
                        },
                        {
                            "id": "quadratic_equations",
                            "name": "一元二次方程",
                            "description": "含有一个未知数，且未知数的最高次数是2的方程",
                            "difficulty": 0.5
                        },
                        {
                            "id": "system_equations",
                            "name": "方程组",
                            "description": "由两个或多个方程组成的方程组",
                            "difficulty": 0.6
                        }
                    ]
                },
                {
                    "id": "geometry",
                    "name": "几何",
                    "description": "几何学基础知识",
                    "children": [
                        {
                            "id": "triangles",
                            "name": "三角形",
                            "description": "由三条边组成的平面图形",
                            "difficulty": 0.4
                        },
                        {
                            "id": "circles",
                            "name": "圆",
                            "description": "平面上到定点距离等于定长的点的集合",
                            "difficulty": 0.5
                        },
                        {
                            "id": "coordinate",
                            "name": "坐标几何",
                            "description": "用坐标方法研究几何图形",
                            "difficulty": 0.7
                        }
                    ]
                },
                {
                    "id": "functions",
                    "name": "函数",
                    "description": "函数与图像",
                    "children": [
                        {
                            "id": "linear_functions",
                            "name": "一次函数",
                            "description": "形如y=kx+b的函数",
                            "difficulty": 0.4
                        },
                        {
                            "id": "quadratic_functions",
                            "name": "二次函数",
                            "description": "形如y=ax²+bx+c的函数",
                            "difficulty": 0.6
                        },
                        {
                            "id": "exponential_functions",
                            "name": "指数函数",
                            "description": "形如y=a^x的函数",
                            "difficulty": 0.7
                        }
                    ]
                }
            ]
        },
        {
            "id": "computer_network",
            "name": "计算机网络",
            "description": "计算机网络知识体系",
            "children": [
                {
                    "id": "tcp_ip",
                    "name": "TCP/IP协议族",
                    "description": "传输控制协议和网际协议",
                    "children": [
                        {
                            "id": "tcp_handshake",
                            "name": "TCP三次握手",
                            "description": "TCP连接建立过程，同步双方初始序号，确认双方收发能力",
                            "difficulty": 0.5
                        },
                        {
                            "id": "tcp_wavehand",
                            "name": "TCP四次挥手",
                            "description": "TCP连接释放过程，双方确认数据传输完成",
                            "difficulty": 0.6
                        },
                        {
                            "id": "tcp_state_machine",
                            "name": "TCP状态机",
                            "description": "TCP连接的各种状态及转换，包括LISTEN、SYN_RCVD、ESTABLISHED等",
                            "difficulty": 0.7
                        }
                    ]
                },
                {
                    "id": "tcp_congestion",
                    "name": "TCP拥塞控制",
                    "description": "TCP拥塞控制机制，防止网络拥塞",
                    "children": [
                        {
                            "id": "slow_start",
                            "name": "慢启动",
                            "description": "TCP拥塞控制的初始阶段，cwnd指数增长直到达到ssthresh",
                            "difficulty": 0.6
                        },
                        {
                            "id": "congestion_avoidance",
                            "name": "拥塞避免",
                            "description": "cwnd超过ssthresh后线性增长，每RTT增加1个MSS",
                            "difficulty": 0.5
                        },
                        {
                            "id": "fast_retransmit",
                            "name": "快速重传",
                            "description": "连续收到3个重复ACK后立即重传，无需等待超时",
                            "difficulty": 0.6
                        },
                        {
                            "id": "fast_recovery",
                            "name": "快速恢复",
                            "description": "快速重传后不进入慢启动，而是进入拥塞避免阶段",
                            "difficulty": 0.7
                        },
                        {
                            "id": "ssthresh",
                            "name": "慢启动阈值",
                            "description": "ssthresh是慢启动和拥塞避免的分界点，cwnd<ssthresh时慢启动",
                            "difficulty": 0.5
                        },
                        {
                            "id": "tcp_rto",
                            "name": "超时重传RTO",
                            "description": "基于RTT动态计算重传超时时间，RTO=SRTT+4*RTTVAR",
                            "difficulty": 0.6
                        }
                    ]
                },
                {
                    "id": "tcp_flow",
                    "name": "TCP流量控制",
                    "description": "TCP基于滑动窗口的流量控制机制",
                    "children": [
                        {
                            "id": "sliding_window",
                            "name": "滑动窗口",
                            "description": "TCP滑动窗口机制，实现流量控制和可靠传输",
                            "difficulty": 0.6
                        },
                        {
                            "id": "rwnd",
                            "name": "接收窗口rwnd",
                            "description": "接收端通过rwnd告知发送端可接收的数据量",
                            "difficulty": 0.5
                        },
                        {
                            "id": "zero_window_probe",
                            "name": "零窗口探测",
                            "description": "rwnd=0时发送端定期发送探测报文，检查接收端状态",
                            "difficulty": 0.6
                        }
                    ]
                },
                {
                    "id": "tcp_header",
                    "name": "TCP报文段",
                    "description": "TCP报文段首部结构和字段含义",
                    "children": [
                        {
                            "id": "tcp_seq_ack",
                            "name": "序号和确认号",
                            "description": "seq是发送数据的序号，ack是期望接收的下一个字节序号",
                            "difficulty": 0.5
                        },
                        {
                            "id": "tcp_flags",
                            "name": "标志位",
                            "description": "SYN、ACK、FIN、RST、PSH、URG等标志位的作用",
                            "difficulty": 0.5
                        },
                        {
                            "id": "tcp_mss",
                            "name": "最大报文段MSS",
                            "description": "TCP能发送的最大数据长度，MSS=MTU-IP头-TCP头",
                            "difficulty": 0.4
                        }
                    ]
                }
            ]
        }
    ]
}