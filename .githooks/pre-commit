#!/bin/sh
# MagicStudy pre-commit hook (fast checks only)
# 退出码: 0=通过, 1=校验失败, 2=环境错误
#
# 仅检查暂存区中被修改的知识库文件，不运行 Qdrant 同步、
# Embedding 和网络链接访问等慢操作。
# 完整 validate-all 请运行: python backend/manage_knowledge.py validate-all
# 或安装 pre-push 钩子 (.githooks/pre-push)

# 定位仓库根目录
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$REPO_ROOT" ]; then
    echo "[ERROR] 无法定位 Git 仓库根目录"
    exit 2
fi

# 选择 Python 解释器
if command -v python >/dev/null 2>&1; then
    PYTHON=python
elif command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
else
    echo "[ERROR] 未找到 Python 解释器"
    exit 2
fi

# 调用 Python 钩子脚本
HOOK_SCRIPT="$REPO_ROOT/backend/scripts/pre_commit_hook.py"
if [ ! -f "$HOOK_SCRIPT" ]; then
    echo "[ERROR] 钩子脚本不存在: $HOOK_SCRIPT"
    exit 2
fi

exec "$PYTHON" "$HOOK_SCRIPT"
