#!/bin/sh
# MagicStudy pre-push hook (full validate-all, slow operations)
# 退出码: 0=通过, 1=校验失败, 2=环境错误
#
# 此钩子在 git push 之前运行完整的 validate-all 校验。
# 包含知识树、依赖关系、题库、来源追溯等全部检查。
# 可通过 git push --no-verify 跳过（紧急情况）。

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$REPO_ROOT" ]; then
    echo "[ERROR] 无法定位 Git 仓库根目录"
    exit 2
fi

if command -v python >/dev/null 2>&1; then
    PYTHON=python
elif command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
else
    echo "[ERROR] 未找到 Python 解释器"
    exit 2
fi

# 读取将要推送的分支信息
# 入参格式: <local ref> <local sha1> <remote ref> <remote sha1>
while read -r local_ref local_sha remote_ref remote_sha; do
    # 只在推送分支时校验（不校验删除操作）
    if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
        echo "[pre-push] 运行完整校验..."
        cd "$REPO_ROOT"
        "$PYTHON" backend/manage_knowledge.py validate-all --policy release
        EXIT_CODE=$?
        if [ $EXIT_CODE -ne 0 ]; then
            echo "[pre-push] 校验失败（exit=$EXIT_CODE）"
            echo "[pre-push] 紧急跳过请使用: git push --no-verify"
            exit $EXIT_CODE
        fi
        break  # 只校验一次
    fi
done

exit 0
