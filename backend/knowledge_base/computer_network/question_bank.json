    {
      "question_id": "cn_q_04_06_001",
      "knowledge_point_id": "cn_004_006",
      "knowledge_point_name": "TCP拥塞控制",
      "question_type": "single_choice",
      "difficulty": 0.5,
      "score": 2,
      "question": "TCP拥塞控制中，拥塞窗口(cwnd)的主要作用是什么？",
      "options": [
        {
          "key": "A",
          "text": "限制接收方缓冲区大小"
        },
        {
          "key": "B",
          "text": "根据网络拥塞情况动态调整发送速率"
        },
        {
          "key": "C",
          "text": "确定TCP连接的最大报文段长度"
        },
        {
          "key": "D",
          "text": "设置TCP连接的超时时间"
        }
      ],
      "answer": "B",
      "analysis": "拥塞窗口(cwnd)是TCP拥塞控制的核心机制，由发送方根据网络拥塞情况动态调整，用于限制发送速率。接收窗口(rwnd)才是限制接收方缓冲区大小的。",
      "reference": [
        "计算机网络：自顶向下方法",
        "第3章",
        "3.7节"
      ],
      "source_ids": [
        "cn_src_001",
        "cn_src_003"
      ],
